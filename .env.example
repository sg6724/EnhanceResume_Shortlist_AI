# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://iwoyzhjhtmxtdbcimnyo.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-from-supabase-dashboard>

# Direct PostgreSQL connection for Procrastinate job queue (NO Redis needed)
# Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the Transaction pooler (port 5432), replace [YOUR-PASSWORD]:
DATABASE_URL=postgresql+asyncpg://postgres.iwoyzhjhtmxtdbcimnyo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Internal services ─────────────────────────────────────────────────────
COMPILE_SERVICE_URL=http://localhost:8001

# ─── LLM — Gemini (aistudio.google.com → Get API key) ─────────────────────
GEMINI_API_KEY=

# ─── Email — Resend (resend.com — free tier, 3000 emails/month) ────────────
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# ─── Founder outreach — Hunter.io (hunter.io — free tier, 25 searches/month) ─
HUNTER_API_KEY=

# ─── Job scraping — Adzuna (developer.adzuna.com — free 1k calls/day) ──────
# Optional: RemoteOK is used automatically without any key
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ─── Single user ───────────────────────────────────────────────────────────
